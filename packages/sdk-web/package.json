{
  "name": "@onboardflow/web",
  "version": "1.0.0",
  "description": "Universal zero-dependency onboarding and spotlight walkthrough SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
