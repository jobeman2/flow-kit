{
  "name": "onboardflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Onboarding-as-a-Service SaaS & Universal SDK Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @onboardflow/database db:generate",
    "db:push": "pnpm --filter @onboardflow/database db:push",
    "db:seed": "pnpm --filter @onboardflow/database db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.7.0"
}
