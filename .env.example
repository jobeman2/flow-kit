# Database Configuration (PostgreSQL)
# Adjust with your local postgres username, password, host, port, and database name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onboardflow?schema=public"

# Redis Configuration (Optional - in-memory fallback is automatically enabled)
REDIS_HOST="localhost"
REDIS_PORT=6379

# API Server
API_PORT=4000
API_HOST="http://localhost:4000"
JWT_SECRET="onboardflow-super-secret-jwt-key-change-in-production"

# Dashboard
NEXT_PUBLIC_API_URL="http://localhost:4000"
PORT=3000

# Clerk Authentication (Dashboard)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/console
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/console
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
